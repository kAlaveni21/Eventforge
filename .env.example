# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server Port
PORT=3000

# MongoDB Connection String (optional - automatically falls back to in-memory MongoDB if empty or unreachable)
MONGODB_URI="mongodb://127.0.0.1:27017/eventforge"

# JWT Secret for Signing Authentication Tokens
JWT_SECRET="eventforge_jwt_secret_key_2026_super_secure"
